<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\GreenBox.I18n.Core\GreenBox.I18n.Core.csproj" />
    <ProjectReference Include="..\GreenBox.I18n.Workspace\GreenBox.I18n.Workspace.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>greenbox-i18n-host</AssemblyName>
  </PropertyGroup>

  <Target Name="BuildEditorWeb" BeforeTargets="ComputeFilesToPublish" Condition="'$(BuildEditorWeb)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\eng\Build-Web.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\wwwroot&quot;" />
  </Target>

</Project>
